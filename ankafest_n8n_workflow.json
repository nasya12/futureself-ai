    {
      "id": "c4",
      "name": "Rapor hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        900
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.code);\nconst seen = rows.filter(r => r.first_in);\nconst inside = rows.filter(r => r.inside).length;\nconst avg = seen.length ? Math.round(seen.reduce((a, r) => a + (r.total_minutes || 0), 0) / seen.length) : 0;\nconst fmt = t => t ? new Date(t).toLocaleTimeString('tr-TR', { timeZone: 'Europe/Istanbul' }) : '-';\nconst list = seen.map(r => '<tr><td>' + r.full_name + '</td><td>' + r.type + '</td><td>' + fmt(r.first_in)\n  + '</td><td>' + fmt(r.last_out) + '</td><td>' + r.total_minutes + ' dk</td></tr>').join('');\nconst html = '<h2>ANKAFEST günlük katılım raporu</h2><p>Kayıt: ' + rows.length + ' · Giriş yapan: ' + seen.length\n  + ' · İçeride: ' + inside + ' · Ortalama kalış: ' + avg + ' dk</p>'\n  + '<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\"><tr><th>Ad</th><th>Tür</th><th>İlk giriş</th><th>Son çıkış</th><th>Süre</th></tr>' + list + '</table>';\nreturn [{ json: { html } }];"
      }
    },
