    {
      "id": "a3",
      "name": "Doğrula ve kod üret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst errors = [];\nif (!['yarismaci', 'ziyaretci'].includes(b.type)) errors.push('type');\nif (!b.full_name || String(b.full_name).trim().length < 3) errors.push('full_name');\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(b.email || '')) errors.push('email');\nif (b.kvkk !== true) errors.push('kvkk');\nif (b.type === 'yarismaci' && (!b.team_name || !b.project_name)) errors.push('team_name/project_name');\nconst A = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\nlet code = 'ANK-';\nfor (let i = 0; i < 6; i++) code += A[Math.floor(Math.random() * A.length)];\nconst clean = s => (s || '').toString().trim().slice(0, 500);\nreturn [{ json: { valid: errors.length === 0, errors, record: {\n  code, type: b.type, full_name: clean(b.full_name), email: clean(b.email).toLowerCase(),\n  phone: clean(b.phone), org: clean(b.org), team_name: clean(b.team_name), category: clean(b.category),\n  project_name: clean(b.project_name), team_size: Number(b.team_size) || null,\n  project_summary: clean(b.project_summary), visit_pref: clean(b.visit_pref),\n  party_size: Number(b.party_size) || null, kvkk: true } } }];"
      }
    },
    {
      "id": "a4",
      "name": "Geçerli mi",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a5",
