      "parameters": {
        "method": "GET",
        "url": "={{ $('Ayarlar (kapı)').first().json.supabaseUrl }}/rest/v1/ankafest_scans?select=type,ts&order=ts.desc&limit=1&code=eq.{{ $json.code }}",
        "authentication": "predefinedCredentialType",
