    {
      "id": "n3",
      "name": "Doğrula",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "jsCode": "// Gelen formu temizle ve kuralları kontrol et.\nconst raw = $input.first().json;\nconst b = raw.body ?? raw;                       // webhook verisi .body içinde gelir\nconst nickname = String(b.nickname ?? '').trim().slice(0, 30);\nconst idea = String(b.idea ?? '').replace(/\\s+/g, ' ').trim();\nconst stage = ['fikir', 'prototip', 'kullanici'].includes(b.stage) ? b.stage : 'fikir';\n\nlet error = null;\nif (b.website) error = 'Geçersiz istek.';                       // bal küpü (honeypot) alanı: botlar doldurur\nelse if (nickname.length < 2) error = 'Takma ad en az 2 karakter olmalı.';\nelse if (idea.length < 20) error = 'Fikir en az 20 karakter olmalı.';\nelse if (idea.length > 600) error = 'Fikir en fazla 600 karakter olabilir.';\n\nreturn [{ json: { valid: !error, error, token: String(b.token ?? ''), idea: { nickname, idea_text: idea, stage } } }];"
      }
    },
    {
      "id": "n4",
      "name": "Geçerli mi",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
