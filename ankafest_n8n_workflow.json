        900,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Ayarlar (başvuru)').first().json.supabaseUrl }}/rest/v1/ankafest_registrations",
        "authentication": "predefinedCredentialType",
