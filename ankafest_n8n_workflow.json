        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.record) }}"
      }
    },
    {
      "id": "a6",
      "name": "QR ve e-posta hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        -100
      ],
      "parameters": {
        "jsCode": "const r = $('Doğrula ve kod üret').first().json.record;\nconst qr = 'https://quickchart.io/qr?size=360&margin=2&text=' + encodeURIComponent(r.code);\nconst detay = r.type === 'yarismaci'\n  ? ('Takım: ' + r.team_name + ' (' + r.category + ')<br>Proje: ' + r.project_name)\n  : ('Ziyaret tercihi: ' + (r.visit_pref || '-') + '<br>Kişi sayısı: ' + (r.party_size || 1));\nconst html = '<div style=\"font-family:Arial,sans-serif;max-width:520px\">'\n  + '<h2>ANKAFEST biletin hazır</h2><p>Merhaba ' + r.full_name + ',</p>'\n  + '<p>Başvurun alındı.<br>' + detay + '</p>'\n  + '<p><img src=\"' + qr + '\" width=\"220\" height=\"220\" alt=\"QR kod\"></p>'\n  + '<p>Kodun: <b>' + r.code + '</b></p>'\n  + '<p>Girişte bu QR kodu okut. Giriş ve çıkış saatlerin otomatik kaydedilir. QR kod ekte de yer alır.</p></div>';\nreturn [{ json: { code: r.code, email: r.email, qr, subject: 'ANKAFEST biletin hazır · ' + r.code, html } }];"
      }
    },
    {
      "id": "a7",
      "name": "QR görselini indir",
