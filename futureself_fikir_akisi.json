    {
      "id": "n16",
      "name": "Yanıt: Giriş Gerekli",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        -60
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, code: 'auth', error: 'Oturum geçersiz, tekrar giriş yap.' }) }}",
        "options": {
          "responseCode": 401,
          "responseHeaders": {
