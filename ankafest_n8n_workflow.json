    {
      "id": "b7",
      "name": "Giriş mi çıkış mı",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        420
      ],
      "parameters": {
        "jsCode": "const reg = $('Kayıt bul').first().json;\nconst last = $json.type ? $json : null;\nconst dup = !!(last && (Date.now() - new Date(last.ts).getTime() < 5000));\nconst next = last && last.type === 'giris' ? 'cikis' : 'giris';\nreturn [{ json: { dup, next, name: reg.full_name, code: reg.code, who: reg.type,\n  gate: $('Kodu hazırla').first().json.gate, ts: new Date().toISOString() } }];"
      }
    },
